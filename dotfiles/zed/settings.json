{
  // keep plain
  "disable_ai": true,
  // font
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Eclat Nocturne",
  // disable the annoying
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "title_bar": {
    "show_user_picture": false
  },
  // misc
  "cli_default_open_behavior": "existing_window",
  // global lsp
  "languages": {
    "Nix": {
      "language_servers": ["nixd"]
    }
  }
}
