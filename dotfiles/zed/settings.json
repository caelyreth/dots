{
  // keep plain
  "disable_ai": true,
  // font
  "ui_font_size": 16,
  "ui_font_family": "Noto Serif CJK SC",
  "buffer_font_size": 15,
  "buffer_font_family": "Maple Mono NF CN",
  "buffer_font_weight": 300,
  "theme": "Eclat Nocturne",
  // terminal
  "terminal": {
    "font_size": 14.5,
    "cursor_shape": "bar",
  },
  // disable the annoying
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "title_bar": {
    "show_user_picture": false
  },
  // misc
  "cli_default_open_behavior": "existing_window",
  // global lsp
  "languages": {
    "Nix": {
      "language_servers": ["nixd"]
    }
  }
}
